# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API (or "API Keys").

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key. Safe to use in the browser (all access is checked by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key. SERVER ONLY. Used to create staff accounts and reset passwords.
# Never put this in a NEXT_PUBLIC_ variable and never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Product photos on Cloudinary (recommended). Cloudinary dashboard -> Settings -> API Keys.
# SERVER ONLY – the phone gets a one-photo signature from the server, never the secret.
# Leave all three empty to keep photos in Supabase Storage instead.
# (You can instead set CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: passwords used by `npm run seed` for the demo accounts.
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=
